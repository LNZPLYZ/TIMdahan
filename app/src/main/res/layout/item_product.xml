<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/rounded_card"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:padding="12dp">

    <!-- Category / Product Icon -->
    <ImageView
        android:id="@+id/iv_product_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/rounded_button"
        android:backgroundTint="@color/icon_bg_blue"
        android:contentDescription="Product Icon"
        android:padding="10dp"
        android:src="@drawable/ic_products"
        app:tint="@color/button_blue" />

    <!-- Name & Info Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_product_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Category | Price: ₱0.00"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Stock Quantity & Low Alert Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_product_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 left"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_stock_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@color/success_bg_tint"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="In stock"
            android:textColor="@color/success_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Edit Action Button -->
    <ImageView
        android:id="@+id/btn_edit_product"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Edit Product"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_edit"
        app:tint="@color/text_secondary" />

    <!-- Delete Action Button -->
    <ImageView
        android:id="@+id/btn_delete_product"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Delete Product"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/error_red" />

</LinearLayout>